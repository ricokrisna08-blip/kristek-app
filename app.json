{
  "expo": {
    "name": "kristek-scaffold",
    "slug": "kristek-scaffold",
    "owner": "rico.krisna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2D5B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.kristekscaffold"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi butuh akses galeri untuk memilih foto bukti pekerjaan.",
          "cameraPermission": "Aplikasi butuh akses kamera untuk mengambil foto bukti pekerjaan."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikasi butuh akses lokasi untuk mencatat titik GPS saat foto bukti pekerjaan diambil."
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "76713942-7adf-4b9f-95f8-5cefc0c41c42"
      }
    }
  }
}
